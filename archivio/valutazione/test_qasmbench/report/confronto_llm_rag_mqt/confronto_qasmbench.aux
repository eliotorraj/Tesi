\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Tutti i 50 circuiti per sistema. I timeout sono distinti dai successi sotto soglia. La soglia 0,8 riprende il report di riferimento; non è una garanzia di accuratezza fisica.}}{3}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Qualità sui 48 successi comuni}{4}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A sinistra ogni punto è un circuito: sopra la diagonale prevale LLM + RAG. A destra la distribuzione cumulativa sui medesimi 48 circuiti: a parità di score, una quota più bassa indica meno circuiti con qualità bassa.}}{4}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Dove cambiano maggiormente gli score}{5}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Differenze sui singoli circuiti. Valori positivi favoriscono LLM + RAG. Gli indici 39 e 47 non hanno una barra: sono i timeout MQT. L'appendice associa gli indici ai nomi.}}{5}{figure.caption.9}\protected@file@percent }
