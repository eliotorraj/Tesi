{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_recommendation.schema.json",
  "title": "LLM recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "catalog_snapshot_id",
    "selected_device",
    "figure_of_merit",
    "compiler",
    "qiskit_plan",
    "evidence_refs",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "catalog_snapshot_id": {
      "type": "string",
      "pattern": "^(hardware_catalog_[0-9a-f]{64}|legacy_unspecified)$"
    },
    "selected_device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "figure_of_merit": {"const": "expected_fidelity"},
    "compiler": {"const": "qiskit"},
    "qiskit_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimization_level",
        "seed_transpiler",
        "layout_method",
        "routing_method"
      ],
      "properties": {
        "optimization_level": {"type": "integer", "enum": [2, 3]},
        "seed_transpiler": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "layout_method": {
          "enum": [null, "trivial", "dense", "sabre"]
        },
        "routing_method": {
          "enum": [null, "basic", "lookahead", "sabre"]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "record_id",
          "source_type",
          "source_id"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_type": {
            "enum": ["historical_result", "scientific_caveat"]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "parameters",
          "evidence_ref_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "claim_type": {
            "enum": [
              "historical_device_support",
              "historical_configuration_support",
              "live_compatibility",
              "scientific_caveat",
              "historical_evidence_unavailable"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "device_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "caveat_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "evidence_ref_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
