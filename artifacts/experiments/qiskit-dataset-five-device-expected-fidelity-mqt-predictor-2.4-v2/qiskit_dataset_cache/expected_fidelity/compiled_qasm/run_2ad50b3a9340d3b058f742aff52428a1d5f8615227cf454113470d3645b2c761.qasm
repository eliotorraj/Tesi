OPENQASM 2.0;
include "qelib1.inc";
qreg q[56];
creg meas[2];
rx(-pi) q[0];
ry(-3*pi/4) q[0];
rx(-pi/2) q[1];
ry(pi) q[1];
rzz(-pi/2) q[1],q[0];
rx(pi/2) q[0];
ry(pi) q[0];
rx(-pi/2) q[1];
ry(pi) q[1];
rzz(-pi/4) q[1],q[0];
rx(pi/2) q[0];
ry(pi) q[0];
rx(-pi) q[1];
ry(-pi/2) q[1];
barrier q[0],q[1];
measure q[0] -> meas[0];
measure q[1] -> meas[1];
