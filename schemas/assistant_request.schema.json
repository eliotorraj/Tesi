{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistant_request.schema.json",
  "title": "Quantum assistant request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "catalog_snapshot_id",
    "circuit",
    "figure_of_merit_id",
    "hardware_constraints"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "catalog_snapshot_id": {
      "type": "string",
      "pattern": "^hardware_catalog_[0-9a-f]{64}$"
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "source"],
      "properties": {
        "format": {"const": "openqasm2"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000000
        }
      }
    },
    "figure_of_merit_id": {"const": "expected_fidelity"},
    "hardware_constraints": {"$ref": "#/$defs/hardware_constraints"}
  },
  "$defs": {
    "identifier_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "gate_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "hardware_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_provider_ids": {"$ref": "#/$defs/identifier_array"},
        "allowed_device_ids": {"$ref": "#/$defs/identifier_array"},
        "device_qubits": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        },
        "required_native_gate_ids": {"$ref": "#/$defs/gate_array"}
      }
    }
  }
}
