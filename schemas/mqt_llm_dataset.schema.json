{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/mqt_llm_dataset.schema.json",
  "title": "MQT Predictor LLM pipeline dataset",
  "description": "Schema for end-to-end records generated by scripts/07_generate_llm_dataset.py.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset",
    "feature_schema",
    "figure_of_merit",
    "hardware_catalog",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset": {
      "type": "object",
      "required": [
        "name",
        "figure_of_merit",
        "record_count",
        "successful_records",
        "failed_records",
        "timeout_records",
        "generation_configuration",
        "environment"
      ],
      "properties": {
        "name": {
          "const": "mqt_predictor_llm_pipeline"
        },
        "figure_of_merit": {
          "enum": [
            "expected_fidelity",
            "critical_depth"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "successful_records": {
          "type": "integer",
          "minimum": 0
        },
        "failed_records": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_records": {
          "type": "integer",
          "minimum": 0
        },
        "generation_configuration": {
          "type": "object"
        },
        "environment": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "feature_schema": {
      "type": "object",
      "required": [
        "feature_count",
        "ordered_names"
      ],
      "properties": {
        "feature_count": {
          "const": 49
        },
        "ordered_names": {
          "type": "array",
          "minItems": 49,
          "maxItems": 49,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "figure_of_merit": {
      "$ref": "#/$defs/figureOfMerit"
    },
    "hardware_catalog": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hardware"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "figureOfMerit": {
      "type": "object",
      "required": [
        "name",
        "optimization_direction",
        "implementation",
        "description",
        "interpretation"
      ],
      "properties": {
        "name": {
          "enum": [
            "expected_fidelity",
            "critical_depth"
          ]
        },
        "optimization_direction": {
          "const": "maximize"
        },
        "implementation": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": [
        "description",
        "type",
        "num_qubits",
        "operation_names",
        "coupling_map",
        "qubit_properties",
        "instructions"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "num_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "operation_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coupling_map": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "qubit_properties": {
          "type": "array"
        },
        "instructions": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "required": [
        "record_id",
        "status",
        "source_circuit",
        "feature_vector",
        "figure_of_merit",
        "device_selection",
        "compilation",
        "compiled_circuit",
        "error",
        "total_elapsed_seconds"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "status": {
          "enum": [
            "success",
            "error",
            "timeout"
          ]
        },
        "source_circuit": {
          "$ref": "#/$defs/sourceCircuit"
        },
        "feature_vector": {
          "$ref": "#/$defs/featureVector"
        },
        "figure_of_merit": {
          "$ref": "#/$defs/figureOfMerit"
        },
        "device_selection": {
          "oneOf": [
            {
              "$ref": "#/$defs/deviceSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "compilation": {
          "type": [
            "object",
            "null"
          ]
        },
        "compiled_circuit": {
          "oneOf": [
            {
              "$ref": "#/$defs/compiledCircuit"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        },
        "total_elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "device_selection": {
                "$ref": "#/$defs/deviceSelection"
              },
              "compilation": {
                "type": "object"
              },
              "compiled_circuit": {
                "$ref": "#/$defs/compiledCircuit"
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "sourceCircuit": {
      "type": "object",
      "required": [
        "name",
        "format",
        "sha256",
        "qasm2",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "format": {
          "const": "OpenQASM 2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qasm2": {
          "type": "string"
        },
        "summary": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "featureVector": {
      "type": "object",
      "required": [
        "extractor",
        "feature_count",
        "ordered_names",
        "ordered_values",
        "by_name"
      ],
      "properties": {
        "feature_count": {
          "const": 49
        },
        "ordered_names": {
          "type": "array",
          "minItems": 49,
          "maxItems": 49
        },
        "ordered_values": {
          "type": "array",
          "minItems": 49,
          "maxItems": 49,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "by_name": {
          "type": "object",
          "minProperties": 49,
          "maxProperties": 49
        }
      },
      "additionalProperties": true
    },
    "deviceSelection": {
      "type": "object",
      "required": [
        "method",
        "model",
        "ranking",
        "selected_device",
        "offline_ground_truth"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "model": {
          "type": "object"
        },
        "ranking": {
          "type": "array",
          "minItems": 1
        },
        "selected_device": {
          "type": "string"
        },
        "offline_ground_truth": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "compiledCircuit": {
      "type": "object",
      "required": [
        "format",
        "sha256",
        "qasm2",
        "summary",
        "figure_of_merit_score",
        "validation"
      ],
      "properties": {
        "format": {
          "const": "OpenQASM 2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qasm2": {
          "type": "string"
        },
        "summary": {
          "type": "object"
        },
        "figure_of_merit_score": {
          "type": "number"
        },
        "validation": {
          "type": "object",
          "required": [
            "basis_valid",
            "connectivity_valid",
            "unsupported_operations",
            "is_executable_on_target"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
