{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_recommendation_v3.schema.json",
  "title": "LLM recommendation 3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_device",
    "config_id",
    "claim",
    "evidence"
  ],
  "properties": {
    "selected_device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "config_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^E[1-5]$"
      }
    }
  }
}
